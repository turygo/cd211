# Copy to .env next to docker-compose.yml, then fill in the CloudDrive2 values.
# docker compose reads this file automatically.
#
# Web UI / API sign-in starts as admin / adminadmin; change the password in
# the Web UI after signing in. Keep the service inside your trusted network.

# CloudDrive2 gRPC endpoint and account (required).
CD2_ADDRESS=192.168.1.10:19798
CD2_USERNAME=you@example.com
CD2_PASSWORD=your-clouddrive2-password
# Set true only if CloudDrive2 serves plaintext gRPC without TLS.
CD2_INSECURE=false

# 115 folder (as mounted inside CloudDrive2) that receives offline downloads.
CLOUD_ROOT=/115open/云下载

# Owner of created staging directories. CloudDrive2, Sonarr, and Radarr must
# run in the PGID group; see docker-compose.yml comments.
PUID=99
PGID=100
