# Copy to .env next to docker-compose.yml only if you need to override a
# default below; docker compose reads this file automatically.
#
# This file is only for container identity: PUID/PGID are consumed by the
# entrypoint, which drops privileges before exec'ing the cd211 binary. The
# binary itself reads no environment variables — its startup configuration
# (HTTP address, database path) is passed as command-line flags, and all
# service configuration (CloudDrive2 connection, cloud and local paths,
# timeouts) happens in the first-run web setup wizard at
# http://<nas-ip>:8080 and is stored in SQLite. Keep the service inside your
# trusted network.

# Owner of created staging directories. CloudDrive2, Sonarr, and Radarr must
# run in the PGID group; see docker-compose.yml comments.
PUID=99
PGID=100
